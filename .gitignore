# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Environments
.venv/
venv/
env/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local experiment output (checkpoints you train yourself land in models/)
runs/
outputs/
*.log

# OS
.DS_Store
Thumbs.db

# Webapp runtime artifacts (the app itself IS tracked)
webapp/.venv/
webapp/uploads/
webapp/tmp/

# --------------------------------------------------------------------------
# Secrets. Nothing in this block may ever be committed.
#
# Stripe and SendGrid credentials are read from the process environment only.
# The single tracked file describing them is `webapp/.env.example`, which
# contains variable *names* and empty values - and it is force-allowed below
# precisely because the `.env*` glob above it is deliberately greedy.
# --------------------------------------------------------------------------
.env
.env.*
*.env
!webapp/.env.example
secrets/
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*_secret*
*_credentials*
