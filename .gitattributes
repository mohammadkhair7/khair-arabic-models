# Large binary/data assets are stored with Git LFS.
# Install once per machine:  git lfs install
*.pt   filter=lfs diff=lfs merge=lfs -text
*.pth  filter=lfs diff=lfs merge=lfs -text
*.jsonl filter=lfs diff=lfs merge=lfs -text

# Keep text files LF-normalized in the repo regardless of checkout platform.
*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf
