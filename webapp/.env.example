# ---------------------------------------------------------------------------
# alarabia.chat - example environment
#
# Copy to `.env` and fill in. `.env` is git-ignored and MUST NOT be committed;
# this file is the only one that is tracked, and it must never hold a real
# value for anything marked SECRET.
#
#   cp webapp/.env.example webapp/.env
#
# In production do not use a .env file at all - inject these as container or
# platform environment variables (Railway/Fly/systemd `EnvironmentFile=` with
# 0600 permissions) so the credential never exists in the repository tree.
# ---------------------------------------------------------------------------

# --- site -------------------------------------------------------------------
SITE_DOMAIN=alarabia.chat
INSTITUTE_URL=https://qurancomputing.org
PROJECT_URL=https://hadith.chat

# --- donations --------------------------------------------------------------
# Stripe Payment Links. These are public URLs, not credentials: Stripe hosts
# the checkout page, so this app never sees a card number and needs no Stripe
# secret key, no publishable key and no webhook secret.
DONATE_MONTHLY_URL=https://buy.stripe.com/00g3eO7Mce0v3Cg7sy
DONATE_ONETIME_URL=https://buy.stripe.com/00g16GeaAbSn3CgcMV

# --- feedback email (SendGrid) ----------------------------------------------
# SECRET - leave blank here. Set it in the deployment environment only.
# Scope the key to "Mail Send" alone; it needs nothing else.
SENDGRID_API_KEY=
# Not secret. Must be a verified sender on the SendGrid account.
SENDGRID_FROM_EMAIL=info@hadith.chat
# Where the feedback form lands.
CONTACT_EMAIL=info@hadith.chat

# --- optional virus scanning ------------------------------------------------
# Point at a clamd instance to scan every upload before it is parsed.
# ARABICWEB_CLAMD_HOST=127.0.0.1
# ARABICWEB_CLAMD_PORT=3310
# Refuse uploads when the scanner is unreachable (recommended in production).
# ARABICWEB_CLAMAV_REQUIRED=1

# --- optional limits (defaults shown) ---------------------------------------
# ARABICWEB_MAX_UPLOAD_MB=8
# ARABICWEB_MAX_TEXT_CHARS=200000
# ARABICWEB_MAX_UNITS=2000
# ARABICWEB_PROCESS_TIMEOUT_S=180
# ARABICWEB_RATE_LIMIT_REQUESTS=30
# ARABICWEB_RATE_LIMIT_WINDOW_S=60
# ARABICWEB_RESULT_TTL_S=600

# --- optional models / rendering --------------------------------------------
# ARABICWEB_DEVICE=cuda
# ARABICWEB_PRELOAD=1
# ARABICWEB_PDF_FONT=/usr/share/fonts/truetype/noto/NotoNaskhArabic-Regular.ttf
