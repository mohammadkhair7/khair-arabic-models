# =============================================================================
# alarabia.chat — host-specific configuration TEMPLATE.
#
# Copy to /opt/alarabia/host.env on the target server and edit. This file holds
# ONLY things that change when the app moves to a different machine: where the
# checkout lives, which domain it answers on, and how much of the host it may
# use. Nothing secret belongs here — secrets live in the OKMS object
# `alarabia-chat/deploy` and are fetched just-in-time by cicd/deploy.sh.
#
# This separation is what makes the future move to Server "QC" cheap: the repo
# (deploy/) and the OKMS object stay identical, and only this file changes.
# See docs/ALARABIA_CHAT_OVH_MIGRATION_PLAN.md.
# =============================================================================

# ── Placement ──────────────────────────────────────────────────────────────
# ALARABIA_ROOT holds the git checkout (src/), the read-only GitHub deploy key
# (.ssh/) and this file. There is deliberately no data directory: the app writes
# nothing to disk, so there is no state to point at, back up or carry to QC.
ALARABIA_ROOT=/opt/alarabia

# ── Public identity ────────────────────────────────────────────────────────
ALARABIA_DOMAIN=alarabia.chat
ALARABIA_URL=https://alarabia.chat
INSTITUTE_URL=https://qurancomputing.org
PROJECT_URL=https://hadith.chat

# ── Donations ──────────────────────────────────────────────────────────────
# Stripe Payment Links — public URLs, NOT credentials, which is why they belong
# here and not in OKMS. Stripe hosts the checkout page, so the app never sees a
# card number and needs no Stripe key of any kind. These are the same two links
# tajweed.chat and hadith.chat use, so a donation lands in the same place
# whichever site the visitor came from.
DONATE_MONTHLY_URL=https://buy.stripe.com/00g3eO7Mce0v3Cg7sy
DONATE_ONETIME_URL=https://buy.stripe.com/00g16GeaAbSn3CgcMV

# ── Edge ───────────────────────────────────────────────────────────────────
# CO_HOSTED: a shared edge Caddy already owns :80/:443 on this host and routes
# by hostname, so this app only contributes an upstream snippet.
# STANDALONE would instead mean this app brings its own Caddy.
ALARABIA_EDGE_MODE=CO_HOSTED
EDGE_DIR=/opt/deploy/edge
EDGE_SNIPPET_DIR=/opt/deploy/edge/upstreams
EDGE_CONTAINER=edge-caddy
EDGE_NETWORK=edge

# Private network carrying nothing but this app's clamd traffic.
ALARABIA_NETWORK=alarabia-net

DEPLOY_DIR=/opt/deploy
DEPLOY_UNIT=dcx-deploy@alarabia-chat

# ── Runtime shape ──────────────────────────────────────────────────────────
# CPU only — the four checkpoints total 62 MB and this host has no GPU.
# Preloading them costs ~1 GB of RSS at startup and makes the first public
# request fast instead of paying a few seconds of load time on it.
ALARABIA_DEVICE=cpu
ALARABIA_PRELOAD=1
ALARABIA_START_PERIOD=120s

# ── Request ceilings ───────────────────────────────────────────────────────
# These bound what one anonymous request can cost. Raising MAX_UPLOAD_MB also
# needs the edge `request_body max_size` raised in /opt/deploy/edge/Caddyfile,
# or the upload is refused at the proxy before the app applies its own limit.
ALARABIA_MAX_UPLOAD_MB=8
ALARABIA_MAX_UNITS=2000
ALARABIA_PROCESS_TIMEOUT_S=180
ALARABIA_RATE_LIMIT_REQUESTS=30
ALARABIA_RATE_LIMIT_WINDOW_S=60
ALARABIA_RESULT_TTL_S=600

# ── Upload screening ───────────────────────────────────────────────────────
# 1 = refuse uploads when clamd is unreachable (fail closed). Pasted text is
# never affected. Set to 0 only while debugging the scanner.
ALARABIA_CLAMAV_REQUIRED=1

# ── Resource ceilings ──────────────────────────────────────────────────────
# Explicit caps so a leak in a document parser cannot disturb the co-hosted
# apps (Quran.chat, Hadith.chat, Tajweed.chat, QuranComputing.org,
# DeepCerebra.io/.net). Preloaded models sit at roughly 1 GB, so 4 GB leaves
# room for concurrent requests without leaving room for a runaway.
ALARABIA_APP_MEM=4g
ALARABIA_APP_CPUS=2.0
ALARABIA_PIDS_LIMIT=256
ALARABIA_CLAMAV_MEM=2g
ALARABIA_CLAMAV_CPUS=1.0
